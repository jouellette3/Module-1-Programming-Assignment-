   ],
   "source": [
    "#3.1 and 3.2\n",
    "seconds_per_hour = 60 * 60\n",
    "\n",
    "print (\"There are \", seconds_per_hour, \" seconds in an hour\")\n",
    "\n",
    "#3.3 and 3.4\n",
    "seconds_per_day = 3600 * 24\n",
    "\n",
    "print (seconds_per_day)\n",
    "\n",
    "#3.5\n",
    "x = seconds_per_day / seconds_per_hour\n",
    "\n",
    "print (x)\n",
    "\n",
    "#3.6\n",
    "y = seconds_per_day // seconds_per_hour\n",
    "\n",
    "print (y)"
   ]
